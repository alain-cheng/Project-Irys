ORDERS.TERMS
ORDERS.NTRANS
ORDERS.PYMNT_TYPE
ORDERS.COMMREM
ORDERS.COMM_AMT_P
ORDERS.COLL_PERC
ORDERS.TMPCOLL

Remarks:
- ORDERS.USERS > Orders.Users will all be turned into NULL
- ORDERS.WHOUSEID > Orders.WarehouseId will all be NULL' , @level0type=N'SCHEMA',@level0name=N'dbo', @level1type=N'TABLE',@level1name=N'Orders';;
GO


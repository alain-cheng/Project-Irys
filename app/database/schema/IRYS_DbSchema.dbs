		<table name="AuditLogs" prior="AuditLog" >
			<comment><![CDATA[NEW TABLE

---
Definitions:

ActorUserId - Authenticated user responsible for the action.
ActorUsername - Username snapshot.
AttemptedUsername - Submitted username for login attempts.
Action - Controlled action code
EntityType - Target table/resource
EntityId - Target record ID
Outcome - Operation outcome
ReasonCode - Controlled reason
BeforeData - JSON data before the action
AfterData - JSON data after the action
CorrelationId - groups entries belonging to an operation
SessionReference - groups activity from one authenticated session]]></comment>
			<column name="Id" type="bigint" mandatory="y" >
				<identity><![CDATA[IDENTITY ( 1 , 1 )]]></identity>
			</column>
			<column name="OccurredAtUtc" type="datetime2" length="7" mandatory="y" >
				<defo><![CDATA[SYSUTCDATETIME()]]></defo>
			</column>
			<column name="ActorUserId" type="int" />
			<column name="ActorUsername" type="varchar" length="255" />
			<column name="AttemptedUsername" type="nvarchar" length="255" />
			<column name="Action" type="varchar" length="32" mandatory="y" />
			<column name="EntityType" type="varchar" length="64" />
			<column name="EntityId" type="int" />
			<column name="Outcome" type="varchar" length="16" mandatory="y" />
			<column name="ReasonCode" type="varchar" length="64" />
			<column name="BeforeData" type="nvarchar(max)" />
			<column name="AfterData" type="nvarchar(max)" />
			<column name="CorrelationId" type="uniqueidentifier" mandatory="y" />
			<column name="SessionReference" type="uniqueidentifier" />
			<index name="pk_AuditLogs" unique="PRIMARY_KEY" >
				<column name="Id" />
			</index>
			<index name="idx_AuditLogs" unique="NORMAL" >
				<column name="OccurredAtUtc" />
			</index>
			<index name="idx_AuditLogs_0" unique="NORMAL" >
				<column name="ActorUserId" />
				<column name="OccurredAtUtc" />
			</index>
			<index name="idx_AuditLogs_1" unique="NORMAL" >
				<column name="EntityType" />
				<column name="EntityId" />
				<column name="OccurredAtUtc" />
			</index>
			<constraint name="Cns_AuditLogs" >
				<string><![CDATA[Action IN ( 'LOGIN', 'LOGOUT', 'REGISTER', 'CREATE', 'READ', 'UPDATE', 'DELETE' )]]></string>
			</constraint>
			<constraint name="Cns_AuditLogs_0" >
				<string><![CDATA[Outcome IN (
    'SUCCESS', 'FAILURE', 'DENIED', 'NO_CHANGE'
)]]></string>
			</constraint>
			<constraint name="Cns_AuditLogs_1" >
				<string><![CDATA[BeforeData IS NULL OR ISJSON(BeforeData) = 1]]></string>
			</constraint>
			<constraint name="Cns_AuditLogs_2" >
				<string><![CDATA[AfterData IS NULL OR ISJSON(AfterData) = 1]]></string>
			</constraint>
